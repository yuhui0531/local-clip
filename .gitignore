# ====================================================================
# Git Ignore Configuration for rea (LocalClip & Documentation)
# ====================================================================

# macOS System & Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Logs & Debug Output
*.log

# Swift & Swift Package Manager (SPM)
.build/
.build-*/
.swiftpm/
.cache/
# 更新发布私钥只保留在本机或 CI secret，禁止进入仓库，by AI.Coding。
.update-signing/
dist/
build/
DerivedData/

# Xcode Project & Workspace User State
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcworkspace/xcshareddata/
*.xcuserdatad/

# Application Bundles & Packaged Archives
*.app/
*.app
*.dmg
*.pkg
*.tar.gz
*.zip

# Benchmark & Probe Binaries
# 只忽略探针二进制，不能误伤 *Probe.swift 等源码
probe
sql-probe
rowid-probe
**/bin/*probe*

# SQLite Databases & Journal / WAL files (Runtime & Test generated)
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# Test & Benchmark Runtime Store Directories
**/fixture-store/
**/working-store/
**/quota-store/
**/store/
**/isolated-data/

# Intermediate Delivery, Review & Validation Artifacts
evidence/delivery/
**/evidence/delivery/
evidence/review-fixes/
**/evidence/review-fixes/

# IDE & Editor Settings
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*~

# Python cache & virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

paste-report/*
debug-log*

changes/active/*
# 过程证据（测试日志、性能样本、验收截图）只保留在本地，不进入仓库
macos-app/evidence/
macos-app/docs/reviews/
